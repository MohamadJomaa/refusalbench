# Copy this file to .env and fill in your own values. Never commit the
# real .env file.

# Gemini, used as the judge (a documented substitute for the paper's
# Claude-4-Sonnet judge). Free tier, no card required:
# https://aistudio.google.com/apikey
# Needed only for the judging stage. Generation, Extension 2 scoring and the
# tests do not use it. The free tier allows about 500 judge calls per day
# per project for gemini-3.5-flash-lite.
GOOGLE_API_KEY=

# Hugging Face token. Optional: Qwen/Qwen1.5-7B-Chat is a public model, a
# token only raises the download rate limit.
# HF_TOKEN=

# Not used by this project. The paper's original code calls proprietary
# models through these; we replaced them with a local Qwen and a Gemini judge.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
